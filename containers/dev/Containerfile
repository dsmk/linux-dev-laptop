FROM registry.fedoraproject.org/fedora-toolbox:44

USER root

# Version should be pinned by the workflow/repository.
#ARG CLAUDE_CODE_VERSION
ENV CLAUDE_CODE_VERSION 2.1.306


# libsecret is here on purpose and is easy to lose in the list below.
# VS Code's Electron runtime reaches the OS keyring by dlopen()ing
# libsecret-1.so.0 at runtime rather than linking against it, so the `code`
# RPM has carried no dependency on it since 1.83 (1.78.0-1.82.3 were the last
# versions that declared one).  On a full GNOME desktop the library is always
# present and the omission never shows; in a minimal toolbx container nothing
# else pulls it in, and VS Code opens with "the OS keyring is not available
# for encryption" and no durable credential storage.  The Secret Service
# itself stays on the host - toolbx bind-mounts /run/user/$UID, so the host's
# gnome-keyring-daemon answers over the shared session bus.  Only the client
# library belongs in the image; do not install gnome-keyring here.
RUN dnf copr enable -y atim/starship \
    && dnf install -y \
      android-tools ansible-core awscli2 \
      ca-certificates cargo chezmoi cmake curl fd-find fzf \
      gcc gcc-c++ gh git git-lfs golang gzip jq just \
      kind krb5-workstation libicu libsecret libunwind make \
      ninja-build nodejs npm openssh-clients openssl-libs opentofu \
      podman python3 python3-devel python3-pip \
      ripgrep rust rust-std-static starship tar unzip wget yq zstd \
    && dnf clean all

# VS Code repository.
RUN rpm --import https://packages.microsoft.com/keys/microsoft.asc \
    && printf '%s\n' \
       '[code]' \
       'name=Visual Studio Code' \
       'baseurl=https://packages.microsoft.com/yumrepos/vscode' \
       'enabled=1' \
       'gpgcheck=1' \
       'gpgkey=https://packages.microsoft.com/keys/microsoft.asc' \
       > /etc/yum.repos.d/vscode.repo \
    && dnf install -y code \
    && dnf clean all

# kubectl from the upstream Kubernetes release channel. Nothing here needs a
# Red Hat subscription, so the resulting image can be published publicly.
# TARGETARCH is supplied by the builder and follows --platform.
ARG TARGETARCH
ARG KUBECTL_VERSION=v1.37.1
ARG KUBECTL_URL=https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl
RUN \
    curl -sSL --fail-with-body -o /var/tmp/kubectl ${KUBECTL_URL} \
    && curl -sSL --fail-with-body -o /var/tmp/kubectl.sha256 ${KUBECTL_URL}.sha256 \
    && printf '%s  %s\n' "$(cat /var/tmp/kubectl.sha256)" /var/tmp/kubectl \
       | sha256sum --check - \
    && install -m 0755 /var/tmp/kubectl /usr/local/bin/kubectl \
    && rm /var/tmp/kubectl /var/tmp/kubectl.sha256

# argoproj publishes one checksum file per release rather than one per asset,
# so the matching line is selected by asset name before the check.
ARG ARGOCD_VERSION=v3.5.4
ARG ARGOCD_RELEASE=https://github.com/argoproj/argo-cd/releases/download/${ARGOCD_VERSION}
ARG ARGOCD_ASSET=argocd-linux-${TARGETARCH}
RUN \
    curl -sSL --fail-with-body -o /var/tmp/argocd ${ARGOCD_RELEASE}/${ARGOCD_ASSET} \
    && curl -sSL --fail-with-body \
       -o /var/tmp/cli_checksums.txt ${ARGOCD_RELEASE}/cli_checksums.txt \
    && printf '%s  %s\n' \
       "$(awk -v asset="${ARGOCD_ASSET}" '$2 == asset { print $1 }' \
          /var/tmp/cli_checksums.txt)" \
       /var/tmp/argocd \
       | sha256sum --check - \
    && install -m 0755 /var/tmp/argocd /usr/local/bin/argocd \
    && rm /var/tmp/argocd /var/tmp/cli_checksums.txt

RUN curl -L -o /usr/local/bin/ot https://github.com/OpenTodoApp/OpenTodo/releases/download/v0.16.0/ot-linux-amd64 \
    && chmod +x /usr/local/bin/ot

# Remove this so we can have Claude installed locally since it updates frequently.
#This uses the npm distribution. Review Anthropic's current installation
# guidance when choosing or updating the pinned version.
#RUN test -n "${CLAUDE_CODE_VERSION}" \
#    && npm install --global \
#       "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
#    && npm cache clean --force

COPY --chmod=0644 podman.sh /etc/profile.d/podman.sh

# Toolbx performs user setup when the container is created.
# Do not bake personal authentication into this image.
