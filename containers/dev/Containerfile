# Developer platform image -- builds both supported flavours.
#
#   FLAVOR=toolbx      image for `toolbox create --image ...`
#   FLAVOR=distrobox   image for `distrobox create --image ...`
#
# The build context is the containers/ directory, NOT containers/dev, because
# the package manifests are shared between flavours. Always build through
# containers/build.sh, which gets the context, platform and build args right:
#
#   containers/build.sh --flavor distrobox
#
# Both flavours install containers/packages/common.txt plus the list named
# after the flavour. Nothing here may depend on a Red Hat subscription: the
# resulting images are published publicly to GHCR.

ARG BASE_IMAGE=registry.fedoraproject.org/fedora-toolbox:44
FROM ${BASE_IMAGE}

# Which package list to layer on top of common.txt. Checked below so that a
# typo fails the build instead of silently producing a half-populated image.
ARG FLAVOR=toolbx

# Supplied by the builder, follows --platform.
ARG TARGETARCH

# ---------------------------------------------------------------------------
# Pinned versions for everything installed outside dnf. Bump these here; they
# are the single source of truth and scripts/validate.sh checks they are set.
# ---------------------------------------------------------------------------
ARG KUBECTL_VERSION=v1.37.1
ARG ARGOCD_VERSION=v3.5.4
ARG OT_VERSION=v0.16.0

# Optional, empty by default: pin dnf to a single Fedora mirror instead of the
# metalink. Only set this when building behind a network policy that allows
# named hosts, because the metalink hands dnf arbitrary third-party mirrors
# that such a policy will deny:
#
#   containers/build.sh --dnf-baseurl https://dl.fedoraproject.org/pub/fedora/linux
#
# It also disables the fedora-cisco-openh264 repository, whose packages are
# served over plain HTTP from ciscobinary.openh264.org and cannot go through
# an HTTPS proxy. Fedora's own `noopenh264` then satisfies the dependency.
# That is a real difference in image contents, so published images are built
# with this UNSET.
ARG DNF_BASEURL=

# Optional, empty by default: the PEM text of an extra CA to trust during the
# build. Needed when building behind a TLS-terminating proxy, which otherwise
# fails the downloads below with curl exit 60. Pass a file with
# `containers/build.sh --proxy-ca FILE`.
#
# This is a CA certificate, never a private key: build args are recorded in
# the image history, so nothing secret may be passed here.
ARG PROXY_CA_CERT=

USER root
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

RUN if [[ -n "${PROXY_CA_CERT}" ]]; then \
      printf '%s\n' "${PROXY_CA_CERT}" \
        > /etc/pki/ca-trust/source/anchors/build-proxy.crt \
      && update-ca-trust extract \
      && echo "trusting build proxy CA"; \
    fi

RUN if [[ -n "${DNF_BASEURL}" ]]; then \
      dnf config-manager setopt \
        fedora.metalink= \
        "fedora.baseurl=${DNF_BASEURL}/releases/\$releasever/Everything/\$basearch/os/" \
        updates.metalink= \
        "updates.baseurl=${DNF_BASEURL}/updates/\$releasever/Everything/\$basearch/" \
        fedora-cisco-openh264.enabled=0; \
      echo "dnf pinned to ${DNF_BASEURL}; fedora-cisco-openh264 disabled"; \
    fi

COPY packages/ /usr/share/developer-platform/packages/

# Base packages. The two lists are concatenated, stripped of comments and
# handed to a single dnf transaction so dependency resolution sees everything.
RUN test -f "/usr/share/developer-platform/packages/${FLAVOR}.txt" \
      || { echo "unknown FLAVOR: ${FLAVOR}" >&2; exit 1; } \
    && dnf copr enable -y atim/starship \
    && mapfile -t packages < <( \
         sed -e 's/#.*//' -e 's/[[:space:]]//g' \
             "/usr/share/developer-platform/packages/common.txt" \
             "/usr/share/developer-platform/packages/${FLAVOR}.txt" \
         | grep -v '^$' ) \
    && dnf install -y "${packages[@]}" \
    && dnf clean all

# VS Code repository.
RUN rpm --import https://packages.microsoft.com/keys/microsoft.asc \
    && printf '%s\n' \
       '[code]' \
       'name=Visual Studio Code' \
       'baseurl=https://packages.microsoft.com/yumrepos/vscode' \
       'enabled=1' \
       'gpgcheck=1' \
       'gpgkey=https://packages.microsoft.com/keys/microsoft.asc' \
       > /etc/yum.repos.d/vscode.repo \
    && dnf install -y code \
    && dnf clean all

# kubectl from the upstream Kubernetes release channel.
ARG KUBECTL_URL=https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl
RUN curl -sSL --fail-with-body -o /var/tmp/kubectl "${KUBECTL_URL}" \
    && curl -sSL --fail-with-body -o /var/tmp/kubectl.sha256 "${KUBECTL_URL}.sha256" \
    && printf '%s  %s\n' "$(cat /var/tmp/kubectl.sha256)" /var/tmp/kubectl \
       | sha256sum --check - \
    && install -m 0755 /var/tmp/kubectl /usr/local/bin/kubectl \
    && rm /var/tmp/kubectl /var/tmp/kubectl.sha256

# argoproj publishes one checksum file per release rather than one per asset,
# so the matching line is selected by asset name before the check.
ARG ARGOCD_RELEASE=https://github.com/argoproj/argo-cd/releases/download/${ARGOCD_VERSION}
ARG ARGOCD_ASSET=argocd-linux-${TARGETARCH}
RUN curl -sSL --fail-with-body -o /var/tmp/argocd "${ARGOCD_RELEASE}/${ARGOCD_ASSET}" \
    && curl -sSL --fail-with-body \
       -o /var/tmp/cli_checksums.txt "${ARGOCD_RELEASE}/cli_checksums.txt" \
    && printf '%s  %s\n' \
       "$(awk -v asset="${ARGOCD_ASSET}" '$2 == asset { print $1 }' \
          /var/tmp/cli_checksums.txt)" \
       /var/tmp/argocd \
       | sha256sum --check - \
    && install -m 0755 /var/tmp/argocd /usr/local/bin/argocd \
    && rm /var/tmp/argocd /var/tmp/cli_checksums.txt

# OpenTodo. Upstream publishes no checksum file and amd64 binaries only, so
# this is installed on x86_64 and skipped elsewhere rather than failing the
# arm64 build.
ARG OT_RELEASE=https://github.com/OpenTodoApp/OpenTodo/releases/download/${OT_VERSION}
RUN if [[ "${TARGETARCH}" == "amd64" ]]; then \
      curl -sSL --fail-with-body -o /var/tmp/ot "${OT_RELEASE}/ot-linux-amd64" \
      && install -m 0755 /var/tmp/ot /usr/local/bin/ot \
      && rm /var/tmp/ot; \
    else \
      echo "ot: no ${TARGETARCH} build published upstream, skipping"; \
    fi

# Claude Code is deliberately NOT baked in. It releases far more often than
# this image, so it is installed into the developer's home directory instead
# and updates itself there.

COPY --chmod=0644 dev/podman.sh /etc/profile.d/podman.sh

# toolbx refuses an image without this label; distrobox ignores it.
LABEL com.github.containers.toolbox="true" \
      org.opencontainers.image.title="developer-platform-${FLAVOR}" \
      org.opencontainers.image.description="Fedora development environment for ${FLAVOR}" \
      org.opencontainers.image.source="https://github.com/dsmk/linux-dev-laptop" \
      org.opencontainers.image.licenses="MIT" \
      dev.linux-dev-laptop.flavor="${FLAVOR}"

# toolbx and distrobox both perform user setup when the container is created.
# Do not bake personal authentication into this image.
